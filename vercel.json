{
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/face-api.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/evidence.js": {
      "maxDuration": 30
    },
    "api/cleanup-evidence.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cleanup-evidence",
      "schedule": "0 20 * * *"
    }
  ]
}